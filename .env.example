# Oten IDP Configuration for Next.js with NextAuth v4
# Copy this file to .env.local and fill in your actual values

# ============================================
# Required: Oten IDP Settings
# ============================================

# Your Oten IDP issuer URL (OIDC Provider)
# Must end with a trailing slash
OTEN_IDP_ISSUER=https://account.oten.live/

# Your application's client ID from Oten Developer Portal
OTEN_IDP_CLIENT_ID=your_client_id_here

# Your application's client secret from Oten Developer Portal
OTEN_IDP_CLIENT_SECRET=your_client_secret_here

# ============================================
# Required: NextAuth v4 Settings
# ============================================

# Your application's URL
# For local development: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Secret key for encrypting session tokens
# Generate a strong random string for production!
# You can generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

